# Copy this file to .env for local testing (never commit .env itself).
# In GitHub Actions, these same values are set as repo secrets instead.

# Free key from https://developer.ticketmaster.com/ (Create App -> Consumer Key)
TICKETMASTER_API_KEY=

# Any string identifying your app is fine, e.g. "bands-alert-app"
BANDSINTOWN_APP_ID=bands-alert-app

# Gmail (or any SMTP provider) used to send the email-to-SMS message
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
# Gmail App Password (not your normal password) - see README for setup
SMTP_PASS=

# Your phone's carrier email-to-SMS gateway address
ALERT_EMAIL=3053386230@txt.att.net

# Set to "true" to test without sending texts or saving state
DRY_RUN=false
