# Copy this file to .env for local testing (never commit .env itself).
# In GitHub Actions, these same values are set as repo secrets instead.

# Free key from https://developer.ticketmaster.com/ (Create App -> Consumer Key)
TICKETMASTER_API_KEY=

# Any string identifying your app is fine, e.g. "bands-alert-app"
BANDSINTOWN_APP_ID=bands-alert-app

# CallMeBot WhatsApp API - see README for one-time activation steps
# Your WhatsApp number, in the exact format CallMeBot confirmed when you activated
CALLMEBOT_PHONE=13053386230
# The API key CallMeBot sent you over WhatsApp during activation
CALLMEBOT_APIKEY=

# Set to "true" to test without sending alerts or saving state
DRY_RUN=false
